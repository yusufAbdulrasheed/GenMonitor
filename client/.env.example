# Base URL for the API.
# Dev: leave this unset — Vite's proxy (see vite.config.js) forwards /api,
#      /uploads and /socket.io to http://localhost:5001.
# Prod: set to the API origin including the /api prefix, e.g.
#      VITE_API_URL=https://genmonitor2.onrender.com/api
#
# On Vercel this value is provided by client/vercel.json (build.env), so you
# don't need to set it in the dashboard. Set it here only for a local
# `npm run build` against a remote API.
VITE_API_URL=
