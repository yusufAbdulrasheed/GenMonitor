# ---- Required ----
# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/generator-maintenance
# Secrets for signing JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me
REFRESH_SECRET=replace-me

# ---- Optional (defaults shown) ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d
# Secure flag on auth cookies. Defaults to true when NODE_ENV=production.
# Set to false to run a production build over plain HTTP (e.g. local Docker).
COOKIE_SECURE=

# Background telemetry simulator. Defaults: on when NODE_ENV != production.
ENABLE_SIMULATION=true
SIMULATION_INTERVAL_MS=10000

# Background jobs: alert sweep, maintenance-plan generation, reading retention.
# Defaults: on when NODE_ENV != production.
ENABLE_SCHEDULER=true
ALERT_SWEEP_INTERVAL_MS=30000
MAINTENANCE_SWEEP_INTERVAL_MS=300000
RETENTION_SWEEP_INTERVAL_MS=3600000

# Time-series reading retention in days (TTL index). 0 disables expiry.
READING_RETENTION_DAYS=90

# Real-time push (Socket.IO). Default: on.
SOCKET_ENABLED=true

# Work-order attachment uploads.
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760

# Device ingestion throttle (requests / minute / IP).
INGEST_RATE_MAX=120

# Default labour rate used for work-order cost roll-ups.
DEFAULT_LABOR_RATE=50

# Destructive POST /api/seed. Defaults: on when NODE_ENV != production.
ALLOW_SEED=true

BCRYPT_SALT_ROUNDS=12

# SMTP — when unset, a throwaway Ethereal test inbox is used and the preview
# URL is logged to the server console. Set EMAIL_ENABLED=false to disable
# outbound email entirely (also off automatically when NODE_ENV=test).
EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_NAME=Generator Monitoring System
FROM_EMAIL=noreply@gensys.com
